# Copy to .env and fill in credentials locally. Never commit the populated .env.
BOT_TOKEN=
ADMIN_ID=
TELEGRAM_ARCHIVE_CHAT_ID=
BOT_WORKER_THREADS=4

# Dahaoshang supplier session (private key stays outside the repository).
SUPPLIER_API_BASE_URL=https://auth.lynli.me
SUPPLIER_SESSION_URL=https://auth.lynli.me/_internal/session
SUPPLIER_SESSION_PRIVATE_KEY=/root/.config/fakabot/supplier_session_private.pem
SUPPLIER_AUTOPROCUREMENT_ENABLED=1

# Payment notifications and provider configuration.
ALIPAY_NOTIFY_API_URL=
ALIPAY_NOTIFY_TOKEN=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PUBLIC_KEY_FILE=/root/.config/fakabot/alipay_public.pem
ALIPAY_PRIVATE_KEY_FILE=/root/.config/fakabot/alipay_private.pem
ALIPAY_PAYMENT_MODE=
PAYMENT_AUDIT_CHANNEL_ID=

# TRC20 listener configuration.
TRON_RECEIVE_ADDRESS=
TRONGRID_API_KEY=
TRON_API_URL=

# Optional integrations.
ORDERS_API_URL=
BOT_API_TOKEN=

